# Komik Mirror local/dev environment template
# Copy to .env and replace all placeholder secrets before running.
# NEVER commit .env or use placeholder values in production.

COMPOSE_PROJECT_NAME=komik_mirror_dev

# Ports (bound to 127.0.0.1 only)
WEB_PORT=3000
MAILPIT_UI_PORT=8025

# MySQL 8.4 configuration
MYSQL_DATABASE=komik_mirror
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_MIGRATOR_USER=komik_migrator
MYSQL_MIGRATOR_PASSWORD=replace_with_strong_migrator_password
MYSQL_APP_USER=komik_app
MYSQL_APP_PASSWORD=replace_with_strong_app_password

# Connection strings (override host=db inside Docker Compose)
DATABASE_URL=mysql://komik_app:replace_with_strong_app_password@db:3306/komik_mirror
MIGRATION_DATABASE_URL=mysql://komik_migrator:replace_with_strong_migrator_password@db:3306/komik_mirror

# Better Auth
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters_secret
BETTER_AUTH_URL=http://127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:3000

# Google OAuth 2.0 (leave blank to disable Google sign-in/register)
# Note: Google Cloud Console Web OAuth clients require http://localhost:3000/api/auth/callback/google
# (or your HTTPS domain) rather than raw 127.0.0.1; align BETTER_AUTH_URL & APP_ORIGIN accordingly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Public registration stays disabled until SMTP delivery & login rate limit are verified.
ALLOW_PUBLIC_SIGNUP=false

# Rate limiting (defaults enabled in production & dev)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_SIGNIN_RATE_LIMIT_WINDOW=60
AUTH_SIGNIN_RATE_LIMIT_MAX=10

# SMTP (Mailpit in local dev profile)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Komik Mirror <no-reply@komik-mirror.local>

# Media storage path (mounted volume inside container)
MEDIA_ROOT=/var/lib/komik-mirror/media
SNAPSHOT_DIR=/snapshot

# Shinigami Option A auto-sync (metadata + on-demand remote panels, 0 GB panel storage)
SHINIGAMI_REMOTE_PANELS_ENABLED=true
SYNC_INTERVAL_MINUTES=15
SYNC_LATEST_PAGES=2
SYNC_REQUEST_DELAY_MS=350
SYNC_CHAPTERS_PER_SERIES=100
SYNC_MAX_SERIES_CHAPTER_FETCH=40
